[Unit]
Description=Exchange the paired HID Lab challenge through USB storage

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/hid-lab/pair_host --key %h/.config/hid-lab/host-private.pem
TimeoutStartSec=10s
UMask=0077
NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
